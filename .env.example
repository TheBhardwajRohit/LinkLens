# Copy this file to .env and fill in what you have.
# Every key is optional. Missing keys turn that signal off; the app keeps working.
# Never commit .env. For GitHub Actions, add the same names as repository secrets.

# --- Blacklist services ---
# Google Safe Browsing Lookup API (non-commercial use only)
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal public API (very low free quota)
VIRUSTOTAL_API_KEY=
# urlscan.io (search history; optional scans)
URLSCAN_API_KEY=
# abuse.ch Auth-Key (URLhaus lookups and feeds)
ABUSECH_AUTH_KEY=

# --- GeoIP / ASN (MaxMind GeoLite2, free account) ---
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# --- Database ---
# Local dev (Docker Compose Postgres). Swap for the Supabase connection string to use shared data.
DATABASE_URL=postgresql://linklens:linklens@db:5432/linklens

# --- Supabase (shared database + screenshot storage) ---
SUPABASE_URL=
# Public, read-only key for the website. Safe to expose only with row-level security on.
SUPABASE_ANON_KEY=
# Secret, full access. Server and GitHub Actions only. Never put this in the website.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=screenshots

# --- Sandbox ---
SANDBOX_URL=http://sandbox:8100
SANDBOX_TIMEOUT_SECONDS=30

# --- Our API ---
# Max scans per client IP per hour
SCAN_RATE_LIMIT_PER_HOUR=20

# --- Website ---
VITE_API_URL=http://localhost:8000

# --- Datasets (optional) ---
# Hugging Face token. Not required for PhreshPhish, but raises download rate limits.
HF_TOKEN=
